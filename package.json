{
  "name": "lottery-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && node scripts/build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test:setup": "tsx scripts/test-setup.ts",
    "test:web": "tsx scripts/test-web.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "@better-auth/prisma-adapter": "1.7.12",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "antd": "6.6.7",
    "better-auth": "1.7.12",
    "dayjs": "1.11.23",
    "dotenv": "18.0.8",
    "echarts": "6.1.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
